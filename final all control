#include <Wire.h>
#include "Adafruit_VL53L0X.h"

Adafruit_VL53L0X LOXCENTER = Adafruit_VL53L0X();
Adafruit_VL53L0X LOXLEFT   = Adafruit_VL53L0X();
Adafruit_VL53L0X LOXRIGHT  = Adafruit_VL53L0X();

#define XSHUT_LEFT    12
#define XSHUT_CENTER  4
#define XSHUT_RIGHT   2

// MOTOR A
int IN1_A = 11;
int IN2_A = 10;

// MOTOR B
int IN1_B = 5;
int IN2_B = 6;

// IR
int IR_L = 7;
int IR_R = 8;

void setMotorA(int speed) {

  speed = constrain(speed, -255, 255);

  if (speed > 0) {

    analogWrite(IN1_A, speed);
    digitalWrite(IN2_A, LOW);
  }

  else if (speed < 0) {

    digitalWrite(IN1_A, LOW);
    analogWrite(IN2_A, -speed);
  }

  else {

    digitalWrite(IN1_A, LOW);
    digitalWrite(IN2_A, LOW);
  }
}

void setMotorB(int speed) {

  speed = constrain(speed, -255, 255);

  if (speed > 0) {

    analogWrite(IN1_B, speed);
    digitalWrite(IN2_B, LOW);
  }

  else if (speed < 0) {

    digitalWrite(IN1_B, LOW);
    analogWrite(IN2_B, -speed);
  }

  else {

    digitalWrite(IN1_B, LOW);
    digitalWrite(IN2_B, LOW);
  }
}

void move(int left, int right) {

  setMotorA(left);
  setMotorB(right);
}

void setup() {

  Serial.begin(9600);
  Wire.begin();

  // MOTOR
  pinMode(IN1_A, OUTPUT);
  pinMode(IN2_A, OUTPUT);

  pinMode(IN1_B, OUTPUT);
  pinMode(IN2_B, OUTPUT);

  // IR
  pinMode(IR_L, INPUT);
  pinMode(IR_R, INPUT);

  // XSHUT
  pinMode(XSHUT_CENTER, OUTPUT);
  pinMode(XSHUT_LEFT, OUTPUT);
  pinMode(XSHUT_RIGHT, OUTPUT);

  // ปิดทุกตัวก่อน
  digitalWrite(XSHUT_CENTER, LOW);
  digitalWrite(XSHUT_LEFT, LOW);
  digitalWrite(XSHUT_RIGHT, LOW);

  delay(10);

  // CENTER
  digitalWrite(XSHUT_CENTER, HIGH);
  delay(10);

  if (!LOXCENTER.begin(0x30)) {

    Serial.println("CENTER FAIL");
    while (1);
  }

  // LEFT
  digitalWrite(XSHUT_LEFT, HIGH);
  delay(10);

  if (!LOXLEFT.begin(0x31)) {

    Serial.println("LEFT FAIL");
    while (1);
  }

  // RIGHT
  digitalWrite(XSHUT_RIGHT, HIGH);
  delay(10);

  if (!LOXRIGHT.begin(0x32)) {

    Serial.println("RIGHT FAIL");
    while (1);
  }

  LOXCENTER.startContinuous();
  LOXLEFT.startContinuous();
  LOXRIGHT.startContinuous();

  Serial.println("READY");
}

void loop() {

  int leftIR = digitalRead(IR_L);
  int rightIR = digitalRead(IR_R);

  int frontDist = LOXCENTER.readRangeContinuousMillimeters();
  int leftDist  = LOXLEFT.readRangeContinuousMillimeters();
  int rightDist = LOXRIGHT.readRangeContinuousMillimeters();

  Serial.print("F:");
  Serial.print(frontDist);

  Serial.print(" L:");
  Serial.print(leftDist);

  Serial.print(" R:");
  Serial.println(rightDist);

  // กันตกสนาม
  if (leftIR == LOW || rightIR == LOW) {

    move(-255, -255);
    delay(170);

    move(-220, 220);
    delay(220);
  }

  // กลางเจอ
  else if (frontDist > 0 && frontDist < 450) {

    move(255, 255);
  }

  // ซ้ายเจอ
  else if (leftDist > 0 && leftDist < 450) {

    move(180, 255);
  }

  // ขวาเจอ
  else if (rightDist > 0 && rightDist < 450) {

    move(255, 180);
  }

  // ไม่เจอ
  else {

    move(120, -120);
  }

  delay(10);
}
