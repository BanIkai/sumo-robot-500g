#include <Wire.h>
#include "Adafruit_VL53L0X.h"

Adafruit_VL53L0X lox = Adafruit_VL53L0X();

// ===== MOTOR =====
int IN1_A = 10; int IN2_A = 11;
int IN1_B = 6;  int IN2_B = 5;

// ===== IR  =====
int IR_L = 7;
int IR_R = 8;

void setMotorA(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    analogWrite(IN1_A, speed);
    digitalWrite(IN2_A, LOW);
  } else if (speed < 0) {
    digitalWrite(IN1_A, LOW);
    analogWrite(IN2_A, -speed);
  } else {
    digitalWrite(IN1_A, LOW);
    digitalWrite(IN2_A, LOW);
  }
}

void setMotorB(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    analogWrite(IN1_B, speed);
    digitalWrite(IN2_B, LOW);
  } else if (speed < 0) {
    digitalWrite(IN1_B, LOW);
    analogWrite(IN2_B, -speed);
  } else {
    digitalWrite(IN1_B, LOW);
    digitalWrite(IN2_B, LOW);
  }
}

void move(int left, int right) {
  setMotorA(left);
  setMotorB(right);
}

void setup() {
  Serial.begin(9600);
  pinMode(IR_L, INPUT);
  pinMode(IR_R, INPUT);
  pinMode(IN1_A, OUTPUT); pinMode(IN2_A, OUTPUT);
  pinMode(IN1_B, OUTPUT); pinMode(IN2_B, OUTPUT);

  if (!lox.begin()) {
    while (1);
  }
  lox.startContinuous();
  

}

void loop() {
  int leftIR = digitalRead(IR_L);
  int rightIR = digitalRead(IR_R);
  int distance = lox.readRangeContinuousMillimeters();

  if (leftIR == LOW || rightIR == LOW) {
    move(-255, -255); 
    delay(150);
    move(-200, 200);  
    delay(200);
  } 
  else if (distance > 0 && distance < 600) { 
    move(255, 255);
  } 

  else {
    move(120, -120);
  }

  delay(10); //
}
