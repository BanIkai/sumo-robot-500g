#include <Wire.h>
#include "Adafruit_VL53L0X.h"

Adafruit_VL53L0X lox = Adafruit_VL53L0X();

void setup() {
  Serial.begin(9600);

  if (!lox.begin()) {
    while (1);
  }

  lox.startContinuous(); // เริ่มวัดต่อเนื่อง
}

void loop() {
  int distance = lox.readRangeContinuousMillimeters();

  if (!lox.timeoutOccurred()) {
    Serial.print("Distance: ");
    Serial.print(distance);
    Serial.println(" mm");
  } else {
    Serial.println("Timeout");
  }
}
