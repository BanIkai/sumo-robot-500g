int IR_L = 7;
int IR_R = 8;

void setup() {
  pinMode(IR_L, INPUT);
  pinMode(IR_R, INPUT);
  Serial.begin(9600);
}

void loop() {
  int left = digitalRead(IR_L);
  int right = digitalRead(IR_R);

  if (left == LOW) {
    Serial.print("Left: DETECT ");
  } else {
    Serial.print("Left: NONE ");
  }

  if (right == LOW) {
    Serial.println("Right: DETECT");
  } else {
    Serial.println("Right: NONE");
  }

  delay(200);
}
